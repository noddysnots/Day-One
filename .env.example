# Gemini. Powers the contract compiler (2.5 Pro) and the agent runtime (2.5 Flash).
GEMINI_API_KEY=

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
# The sb_secret_/sb_publishable_ key format does not embed the project ref, so this
# cannot be derived from the keys. It has to come from the project dashboard.
NEXT_PUBLIC_SUPABASE_URL=

# New-format secret key (sb_secret_...), the drop-in replacement for the legacy
# service_role JWT. Server-only: this bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# New-format publishable key (sb_publishable_...), replacing the legacy anon JWT.
# Unused today: every read goes through server components on the secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
